{
  "ui": {
    "constraints": {
      "max_height": 3,
      "max_width": 10
    },
    "colors": null
  },
  "stations": [
    {
      "id": "zellij-tab",
      "metadata": {
        "title": "Zellij Tab"
      },
      "behavior": {
        "picker_type": {
          "SingleChoice": {
            "command": [
              "zellij",
              "action",
              "query-tab-names"
            ],
            "separator": "\n"
          }
        },
        "search_type": "SubStringCaseInsensitive",
        "key_maps": [
          {
            "modifiers": "CONTROL",
            "key": "Enter",
            "action": {
              "ExecuteWithTyped": [
                "zellij",
                "action",
                "new-tab",
                "--name",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          },
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteOnceAndExit": [
                "zellij",
                "action",
                "go-to-tab-name",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": null
    },
    {
      "id": "zellij-session",
      "metadata": {
        "title": "Zellij Session"
      },
      "behavior": {
        "picker_type": {
          "SingleChoice": {
            "command": [
              "zellij",
              "list-sessions",
              "--short"
            ],
            "separator": "\n"
          }
        },
        "search_type": "SubStringCaseInsensitive",
        "key_maps": [
          {
            "modifiers": "CONTROL",
            "key": "Enter",
            "action": {
              "ExecuteWithTyped": [
                "zellij",
                "action",
                "switch-session",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          },
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteOnceAndExit": [
                "zellij",
                "action",
                "switch-session",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": null
    },
    {
      "id": "git-add-multi",
      "metadata": {
        "title": null
      },
      "behavior": {
        "picker_type": {
          "MultiChoice": {
            "command": [
              "git",
              "diff",
              "--name-only"
            ],
            "separator": "\n"
          }
        },
        "search_type": "FuzzySearch",
        "key_maps": [
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteMultiParamAndExit": [
                "git",
                "add",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          },
          {
            "modifiers": "CONTROL",
            "key": {
              "Char": "c"
            },
            "action": {
              "ExecuteMultiParamAndExit": [
                "git",
                "add",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": null
    },
    {
      "id": "find",
      "metadata": {
        "title": "Find"
      },
      "behavior": {
        "picker_type": {
          "MultiChoice": {
            "command": [
              "find"
            ],
            "separator": "\n"
          }
        },
        "search_type": "SubStringCaseInsensitive",
        "key_maps": [
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteMultiParamAndExit": [
                "xdg-open",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": true
          },
          {
            "modifiers": "CONTROL",
            "key": {
              "Char": "c"
            },
            "action": "Exit",
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": null
    }
  ]
}
