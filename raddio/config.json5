{
  "ui": null,
  "stations": [
    {
      "id": "zellij-rename-session",
      "metadata": {
        "title": "Rename Zellij Session"
      },
      "behavior": {
        "picker_type": "EntryBox",
        "search_type": null,
        "key_maps": [
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteWithTypedInput": [
                "zellij",
                "action",
                "rename-session",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": {
        "constraints": {
          "max_height": 3,
          "max_width": 50
        },
        "colors": null
      }
    },
    {
      "id": "zellij-delete-sessions",
      "metadata": {
        "title": "Zellij Tab"
      },
      "behavior": {
        "picker_type": {
          "MultiChoice": {
            "command": [
              "zellij",
              "list-sessions",
              "--short"
            ],
            "separator": "\n"
          }
        },
        "search_type": "SubStringCaseInsensitive",
        "key_maps": [
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteForEachAndExit": [
                "zellij",
                "delete-session",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          },
          {
            "modifiers": "CONTROL",
            "key": "Enter",
            "action": {
              "ExecuteForEachAndExit": [
                "zellij",
                "delete-session",
                "-f",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": null
    },
    {
      "id": "zellij-tab",
      "metadata": {
        "title": "Zellij Tab"
      },
      "behavior": {
        "picker_type": {
          "SingleChoice": {
            "command": [
              "zellij",
              "action",
              "query-tab-names"
            ],
            "separator": "\n"
          }
        },
        "search_type": "SubStringCaseInsensitive",
        "key_maps": [
          {
            "modifiers": "CONTROL",
            "key": "Enter",
            "action": {
              "ExecuteWithTypedInput": [
                "zellij",
                "action",
                "new-tab",
                "--name",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          },
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteOnceAndExit": [
                "zellij",
                "action",
                "go-to-tab-name",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": null
    },
    {
      "id": "zellij-session",
      "metadata": {
        "title": "Zellij Session"
      },
      "behavior": {
        "picker_type": {
          "SingleChoice": {
            "command": [
              "zellij",
              "list-sessions",
              "--short"
            ],
            "separator": "\n"
          }
        },
        "search_type": "SubStringCaseInsensitive",
        "key_maps": [
          {
            "modifiers": "CONTROL",
            "key": "Enter",
            "action": {
              "ExecuteWithTypedInput": [
                "zellij",
                "action",
                "switch-session",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          },
          {
            "modifiers": "",
            "key": "Enter",
            "action": {
              "ExecuteOnceAndExit": [
                "zellij",
                "action",
                "switch-session",
                "{}"
              ]
            },
            "replace_string": "{}",
            "detached": false
          }
        ]
      },
      "ui": null
    }
  ]
